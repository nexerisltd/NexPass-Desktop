{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexPass",
  "version": "6.0.1",
  "identifier": "com.nexapp.nexpass",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NexPass",
        "width": 1360,
        "height": 840,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "NexApp",
    "copyright": "© 2026 NexApp — Developed by Arabi Islam, MR. ARX",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    }
  }
}
