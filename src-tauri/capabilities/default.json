{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for NexPass's main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file",
    "process:allow-restart",
    "nexpass-installer:default"
  ]
}
